# დააკოპირეთ ეს ფაილი როგორც .env.local და შეავსეთ რეალური მონაცემებით.
# ცარიელი მნიშვნელობისთვის საიტი აჩვენებს „შესავსებია“ ველს – არაფერი გამოგონილი არ არის.

NEXT_PUBLIC_SITE_URL=https://your-domain.ge
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_WORKING_HOURS=
# WhatsApp ნომერი საერთაშორისო ფორმატით, მხოლოდ ციფრები (მაგ. 995XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP=
# Google Maps -> Share -> Embed a map -> დააკოპირეთ iframe-ის src მნიშვნელობა
NEXT_PUBLIC_MAP_EMBED_URL=
# თქვენი კომპანიის Google Maps ჩანაწერი -> Share -> Copy link (ღილაკი „რუკაზე ნახვა“)
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_INSTAGRAM=

# სერვერული: ფორმის მონაცემების გადაგზავნა (Zapier / Make / Formspree / საკუთარი endpoint).
# თუ ცარიელია, მოთხოვნები მხოლოდ სერვერის ლოგში ჩაიწერება.
CONTACT_WEBHOOK_URL=
